# Base URL of the Django backend API (no trailing slash).
# Local development: http://127.0.0.1:8000
# Production: https://api.susieqsbooks.org
NEXT_PUBLIC_API_URL=http://127.0.0.1:8000

# PayPal client ID (public identifier, not a secret).
# Use a sandbox client ID for development/preview and the live ID in production.
NEXT_PUBLIC_PAYPAL_CLIENT_ID=your-paypal-client-id

# Sponsorship price per book in USD.
NEXT_PUBLIC_DONATION_AMOUNT_PER_BOOK=10

# Google Analytics 4 measurement ID. Leave unset in development/preview so
# analytics only collects data in production.
# NEXT_PUBLIC_GA_MEASUREMENT_ID=G-CTZWL4FZTT
